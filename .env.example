CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LIVE_ENABLED=false
CALLE_DEFAULT_LANGUAGE=en-US
CALLE_DEFAULT_REGION=MX
EMPLOYE_PORT=8787
EMPLOYE_STATE_FILE=./data/state.json

